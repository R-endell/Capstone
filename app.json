{
  "expo": {
    "name": "Pack-N-Ship",
    "slug": "Pack-N-Ship",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appiconfixed.png",
    "scheme": "packnship",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Pack-N-Ship to access your location to pinpoint pickup and drop-off points.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Pack-N-Ship shares your location with the sender while you are delivering.",
        "NSCameraUsageDescription": "Allow Pack-N-Ship to take photos of your package."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyCxrMHnuiiXQPAWpqFECYHjoE8CNOOxVrg"
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCxrMHnuiiXQPAWpqFECYHjoE8CNOOxVrg"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/appiconfixed.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rendelljames.Capstone",
      "googleServicesFile": "./android/app/google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "packnship"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/appiconfixed.png"
    },
    "plugins": [
      "expo-splash-screen",
      "expo-web-browser",
      "expo-sqlite",
      "expo-status-bar",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyCxrMHnuiiXQPAWpqFECYHjoE8CNOOxVrg",
          "iosGoogleMapsApiKey": "AIzaSyCxrMHnuiiXQPAWpqFECYHjoE8CNOOxVrg"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Pack-N-Ship to access your location to pinpoint pickup and drop-off points.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/appiconfixed.png",
          "color": "#FF751F"
        }
      ],
      "expo-task-manager",
      [
        "expo-build-properties",
        {
          "android": {}
        }
      ],
      [
        "expo-gradle-properties",
        {
          "org.gradle.jvmargs": "-Xmx4096m -XX:MaxMetaspaceSize=1024m -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8",
          "org.gradle.parallel": "false",
          "org.gradle.workers.max": "2",
          "kotlin.daemon.jvmargs": "-Xmx2048m"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "owner": "junjosephps-team",
      "slug": "packnship",
      "eas": {
        "projectId": "1c9f41a3-3eae-47b2-9aef-9ce9350c66e7"
      }
    },
    "owner": "junjosephps-team"
  }
}
