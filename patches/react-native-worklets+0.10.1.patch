+  SerializableRemoteFunction(
+      jsi::Runtime &rnRuntime,
+      const std::string &name,
+      jsi::Function &&function,
+      const std::shared_ptr<JSScheduler> &jsScheduler,
+      const std::shared_ptr<RNRuntimeStatus> &rnRuntimeStatus)
